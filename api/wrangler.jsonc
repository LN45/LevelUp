{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "levelup-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  // Workers AI : appelé via la liaison, aucune clé API à gérer.
  // Toujours distant, même avec wrangler dev (décompté de l'allocation gratuite quotidienne).
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  // Compteur du quota quotidien (simulé en local par wrangler dev)
  "kv_namespaces": [
    {
      "binding": "QUOTA",
      "id": "7f92bdf93c754911a1c9828587a95b7c",
    },
  ],
  "vars": {
    // Lecture des photos : modèle de vision rapide
    "EXTRACT_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct",
    // Fiche, cartes et quiz : texte seulement, modèle choisi pour la justesse des réponses
    "GENERATE_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct",
    "DAILY_LIMIT": "50",
    // Origines autorisées (séparées par des virgules) : production seulement.
    // localhost est ajouté par le script « dev » (wrangler dev --var), jamais déployé.
    "ALLOWED_ORIGINS": "https://ln45.github.io",
  },
}
