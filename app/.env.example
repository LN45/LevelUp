# app/.env.local (gitignoré) est créé par la commande « Jeton d'appli » du README.
# Ce jeton finit dans le code du front : ce n'est pas un vrai secret, mais on ne le commite pas.
VITE_APP_TOKEN=
# Facultatif : URL de l'API (par défaut /api, relayé vers wrangler dev par le proxy Vite)
# VITE_API_URL=
