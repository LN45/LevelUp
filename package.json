{
  "name": "levelup",
  "private": true,
  "workspaces": [
    "app",
    "api"
  ],
  "scripts": {
    "dev": "concurrently -n app,api -c magenta,cyan \"npm:dev:app\" \"npm:dev:api\"",
    "dev:app": "npm run dev -w app",
    "dev:api": "npm run dev -w api",
    "build": "npm run build -w app",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write .",
    "test": "npm run test -w app",
    "typecheck": "npm run typecheck --workspaces"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "devDependencies": {
    "concurrently": "10.0.6",
    "prettier": "3.9.6"
  }
}
